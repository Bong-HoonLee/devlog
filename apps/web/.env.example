# 실제 값은 .env.local 에 넣습니다 (git 커밋 금지).
# Prisma CLI(migrate/generate)는 .env.local 을 읽지 않으므로
# DATABASE_URL / DIRECT_URL 은 .env 에도 같이 넣어야 합니다.

# ─── Site ───
# OG 이미지 / sitemap / RSS / canonical / 구독확인 메일 링크의 기준 주소.
# 개발에서는 미설정 시 http://localhost:3000 으로 폴백하지만,
# 프로덕션 빌드에서 비어 있으면 (Vercel 도메인도 못 찾으면) 빌드가 실패합니다.
NEXT_PUBLIC_SITE_URL="https://devlog-web.vercel.app"

# ─── Supabase / PostgreSQL ───
# DATABASE_URL: 커넥션 풀러(pgbouncer) 주소, DIRECT_URL: 마이그레이션용 직결 주소
DATABASE_URL="postgresql://postgres:password@localhost:5432/myblog"
DIRECT_URL="postgresql://postgres:password@localhost:5432/myblog"

# 이미지 업로드(Supabase Storage, 버킷명: images) — 선택
# 미설정 시: 어드민 에디터의 이미지 업로드만 비활성화되고 나머지는 정상 동작합니다.
# 설정 시 next.config.ts 가 이 URL 의 호스트를 next/image 허용 목록에 자동 추가합니다.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── NextAuth ───
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ─── OAuth ───
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Upstash Redis (선택) ───
# 미설정 시: 조회수는 DB에 직접 기록, Rate limiting은 비활성화됩니다.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Resend (선택) ───
# 미설정 시: 댓글 알림 메일 미발송, 구독은 확인 메일 없이 자동 승인됩니다.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@resend.dev"
